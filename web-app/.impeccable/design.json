  "narrative": {
    "northStar": "Calm teal study workspace",
    "overview": "Operate mode. A personal electronics workspace with iOS-adjacent adaptive navigation, inset groups, restrained translucent chrome and spring feedback. The explicit user brief fixes the mint/pixel identity; this app extends it without replacing the landing page or redesigning the mascot. No approved visual comp exists: this document records the implemented code.",
    "keyCharacteristics": [
      "Teal actions and pale mint selection on cool green neutrals.",
      "Self-hosted Geist, compact labels and comfortable body leading.",
      "Rounded task surfaces, adaptive navigation and finite companion greetings."
    ],
    "rules": [
      {
        "name": "The Semantic Pair Rule",
        "body": "Change foreground and background tokens together when switching themes; preserve their roles rather than reusing a light-theme literal.",
        "section": "colors"
      },
      {
        "name": "The Quiet Chrome Rule",
        "body": "Reserve stronger elevation for overlays; regular study content uses the shared panel treatment.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse semantic color pairs in both themes.",
      "Do preserve adaptive navigation, safe areas, visible labels and keyboard focus.",
      "Do use the exact original pixel mascot with crisp rendering and responsive Next Image delivery.",
      "Do make movement acknowledge navigation, state or a finite greeting and respect reduced motion."
    ],
    "donts": [
      "Don't replace the mint/pixel identity or imply that an iOS reference is an approved comp.",
      "Don't turn chrome microcopy or small badges into the body-text scale.",
      "Don't claim electrical verification from an image or disguise demo activity as live student data."
    ]
  }
}
