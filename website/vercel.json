{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build.mjs",
  "installCommand": "",
  "outputDirectory": "dist",
  "git": { "deploymentEnabled": { "*": false, "codex/ohmi-website": true } },
  "rewrites": [
    { "source": "/app/", "destination": "https://ohmi-workspace.vercel.app/app/" },
    { "source": "/app/:path*/", "destination": "https://ohmi-workspace.vercel.app/app/:path*/" },
    { "source": "/app", "destination": "https://ohmi-workspace.vercel.app/app" },
    { "source": "/app/:path*", "destination": "https://ohmi-workspace.vercel.app/app/:path*" }
  ]
}
