  "narrative": {
    "northStar": "Bold type and horizon",
    "overview": "Large, tightly set sans headings make electronics feel approachable. The approved pixel-art companion brings warmth to a green-black field, with mint actions and a luminous pixel horizon. Quiet lower sections give explanations and setup instructions room to read.\n\nThis system describes the standalone marketing website, not the extension interface. It follows owner-approved Concept C in `design/concept-c-spark.png` and the direction contract in `design/SURFACE.md`; built ground truth is `dist/index.html`, `dist/styles.css`, and `dist/app.js`. Native controls and self-hosted fonts keep the surface direct and lightweight.",
    "keyCharacteristics": [
      "Green-black canvas, ivory hierarchy, mint actions and explanations.",
      "Oversized compact headings beside the unchanged pixel mascot.",
      "Pill controls, quiet hairlines, generous vertical space.",
      "Scripted educational examples with visible limitations.",
      "Brief entrance motion with a complete reduced-motion fallback."
    ],
    "rules": [
      {
        "name": "The Mint Means Action Rule.",
        "body": "Use mint for actionable or explanatory emphasis; keep long supporting paragraphs in Soft Sage.",
        "section": "colors"
      },
      {
        "name": "The Pixel Accent Rule.",
        "body": "Keep pixel lettering to the wordmark and pixel texture to the approved artwork and sparse decoration; explanatory prose stays in Manrope.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule.",
        "body": "Separate functional containers with surface tone and a single hairline; leave cinematic glow to the decorative horizon and stars.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the exact approved mascot PNG and its complete silhouette.",
      "**Do** reuse the existing mint action, focus, and selected-state vocabulary.",
      "**Do** keep functional surfaces quiet, with tonal separation and hairlines.",
      "**Do** retain semantic headings, native disclosures, keyboard tabs, the skip link, and reduced-motion behavior.",
      "**Do** label examples as scripted and illustrative, and direct setup to the existing source instructions.",
      "**Do** keep this standalone website separate from extension behavior and student data."
    ],
    "donts": [
      "**Don't** regenerate, redraw, crop, or stretch the approved mascot without owner approval.",
      "**Don't** make decorative raster artwork responsible for essential text or interaction.",
      "**Don't** imply Autodesk affiliation, Chrome Web Store availability, electrical verification, or a live AI connection from this page.",
      "**Don't** promote detector exceptions or small helper-copy defects into reusable design rules."
    ]
  }
